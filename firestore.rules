rules_version = '2';

// LEADSERVE CMS — Firestore rules (v4: + super-admin control plane, email membership)
//
// Data shapes:
//  1. legacyRoot (single-clinic demo): flat top-level collections. signed-in + active,
//     with per-module gating via settings/entitlement.
//  2. tenantPath (multi-tenant): clinics/{tid}/<collection>/<doc>, isolated by membership.
//
// Membership of a clinic is granted by EITHER a uid member doc (clinics/{tid}/members/{uid})
// OR the user's email being listed in clinics/{tid}.memberEmails. This lets the browser
// admin console provision clinics without a server (no Admin SDK / Cloud Function needed).
//
// A LEADSERVE super-admin (operator) can read every clinic and create/customize clinics,
// members, and entitlement — the control plane. Everyone else stays locked out.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function email() { return signedIn() ? request.auth.token.email : ''; }

    // LEADSERVE operators (super-admins). Full control-plane access.
    function isSuperAdmin() {
      return signedIn() && email() in ['olitun@me.com'];
    }

    function collectionModule(col) {
      return col.matches('inventory_.*') ? 'inventory'
        : col == 'prescriptions' ? 'prescription'
        : col == 'cf4' ? 'philhealth'
        : (col == 'proc_pr' || col == 'proc_po' || col == 'proc_grn') ? 'procurement'
        : '';
    }

    // ---- legacyRoot (single-tenant demo) ----
    function notDeactivated() {
      return !exists(/databases/$(database)/documents/oms_users/$(request.auth.uid))
        || get(/databases/$(database)/documents/oms_users/$(request.auth.uid)).data.status != 'inactive';
    }
    function rootModuleAllowed(key) {
      return key == ''
        || !exists(/databases/$(database)/documents/settings/entitlement)
        || !('modules' in get(/databases/$(database)/documents/settings/entitlement).data)
        || !(key in get(/databases/$(database)/documents/settings/entitlement).data.modules)
        || get(/databases/$(database)/documents/settings/entitlement).data.modules[key] != false;
    }

    // ---- tenantPath (multi-tenant) ----
    function clinicData(tid) { return get(/databases/$(database)/documents/clinics/$(tid)).data; }
    function emailMember(tid) {
      return exists(/databases/$(database)/documents/clinics/$(tid))
        && 'memberEmails' in clinicData(tid)
        && email() in clinicData(tid).memberEmails;
    }
    function isMember(tid) {
      return signedIn() && (
        isSuperAdmin()
        || exists(/databases/$(database)/documents/clinics/$(tid)/members/$(request.auth.uid))
        || emailMember(tid)
      );
    }
    function tenantModuleAllowed(tid, key) {
      return key == ''
        || !exists(/databases/$(database)/documents/clinics/$(tid)/settings/entitlement)
        || !('modules' in get(/databases/$(database)/documents/clinics/$(tid)/settings/entitlement).data)
        || !(key in get(/databases/$(database)/documents/clinics/$(tid)/settings/entitlement).data.modules)
        || get(/databases/$(database)/documents/clinics/$(tid)/settings/entitlement).data.modules[key] != false;
    }

    // Clinic profile doc: readable by members/super-admin; writable only by super-admin.
    match /clinics/{tid} {
      allow read: if isMember(tid) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // A clinic's data. Members read/write their own clinic (module-gated). members/* and
    // settings/entitlement are control-plane docs — writable only by super-admin.
    match /clinics/{tid}/{col}/{docId} {
      allow read: if (isMember(tid) || isSuperAdmin()) && tenantModuleAllowed(tid, collectionModule(col));
      allow write: if isSuperAdmin()
        || (isMember(tid) && tenantModuleAllowed(tid, collectionModule(col))
            && col != 'members'
            && !(col == 'settings' && docId == 'entitlement'));
    }

    // Per-user directory (reverse membership index). Readable by that user or super-admin;
    // writable only by super-admin (provisioning).
    match /users/{uid} {
      allow read: if (signedIn() && uid == request.auth.uid) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Flat legacyRoot collections (the current demo). Excludes 'clinics' and 'users'.
    match /{col}/{docId} {
      allow read: if signedIn() && notDeactivated()
        && col != 'clinics' && col != 'users' && rootModuleAllowed(collectionModule(col));
      allow write: if signedIn() && notDeactivated()
        && col != 'clinics' && col != 'users' && rootModuleAllowed(collectionModule(col))
        && !(col == 'settings' && docId == 'entitlement');
    }
  }
}

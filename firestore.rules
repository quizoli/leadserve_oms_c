rules_version = '2';

// LEADSERVE OMS — Firestore rules (v1, interim)
//
// Context: this project (leadserve-oms) hosts a SINGLE tenant (the demo clinic)
// in legacyRoot mode, so the PROJECT boundary already provides tenant isolation.
// This v1 improves on the legacy live apps (which allow any signed-in user full
// access) by also blocking deactivated users. It is deliberately simple.
//
// TODO(v2 — before multi-tenant / tenantPath): enforce
//   (a) per-tenant scoping under clinics/{tenantId}/... and
//   (b) per-MODULE entitlement (a clinic that has not licensed a module cannot
//       read/write that module's collections), driven by a tenant entitlement doc.
// See README ROADMAP.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A user is blocked only if they have a profile explicitly marked inactive.
    // New/bootstrap users (no profile yet) are allowed so the first admin can sign in.
    function notDeactivated() {
      return !exists(/databases/$(database)/documents/oms_users/$(request.auth.uid))
        || get(/databases/$(database)/documents/oms_users/$(request.auth.uid)).data.status != 'inactive';
    }

    match /{document=**} {
      allow read, write: if signedIn() && notDeactivated();
    }
  }
}

rules_version = '2';

// LEADSERVE OMS — Firestore rules (v3: multi-tenant isolation + per-module entitlement)
//
// Two data shapes coexist:
//
//  1. legacyRoot (current single-clinic demo): flat top-level collections
//     (patients, visits, oms_slips, prescriptions, inventory_*, ...). Guarded by
//     "signed-in + active", with per-module gating via  settings/entitlement.
//
//  2. tenantPath (multi-tenant SaaS): every clinic's data lives under
//     clinics/{tenantId}/<collection>/<doc>. A user may touch a clinic's data
//     ONLY if they are a member of that clinic (clinics/{tid}/members/{uid} exists).
//     Per-clinic module entitlement lives at clinics/{tid}/settings/entitlement.
//     Membership + entitlement are provisioned by LEADSERVE (Admin SDK/console)
//     and are NOT client-writable — a clinic can neither add members nor grant
//     itself modules, and no clinic can read or write another clinic's data.
//
// Module gating is fail-open (absent entitlement doc = allowed) in both shapes.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // ---- shared module → collection mapping ----
    function collectionModule(col) {
      return col.matches('inventory_.*') ? 'inventory'
        : col == 'prescriptions' ? 'prescription'
        : col == 'cf4' ? 'philhealth'
        : (col == 'proc_pr' || col == 'proc_po' || col == 'proc_grn') ? 'procurement'
        : '';
    }

    // ---- legacyRoot (single-tenant demo) ----
    function notDeactivated() {
      return !exists(/databases/$(database)/documents/oms_users/$(request.auth.uid))
        || get(/databases/$(database)/documents/oms_users/$(request.auth.uid)).data.status != 'inactive';
    }
    function rootModuleAllowed(key) {
      return key == ''
        || !exists(/databases/$(database)/documents/settings/entitlement)
        || !('modules' in get(/databases/$(database)/documents/settings/entitlement).data)
        || !(key in get(/databases/$(database)/documents/settings/entitlement).data.modules)
        || get(/databases/$(database)/documents/settings/entitlement).data.modules[key] != false;
    }

    // ---- tenantPath (multi-tenant) ----
    function isMember(tid) {
      return signedIn()
        && exists(/databases/$(database)/documents/clinics/$(tid)/members/$(request.auth.uid));
    }
    function tenantModuleAllowed(tid, key) {
      return key == ''
        || !exists(/databases/$(database)/documents/clinics/$(tid)/settings/entitlement)
        || !('modules' in get(/databases/$(database)/documents/clinics/$(tid)/settings/entitlement).data)
        || !(key in get(/databases/$(database)/documents/clinics/$(tid)/settings/entitlement).data.modules)
        || get(/databases/$(database)/documents/clinics/$(tid)/settings/entitlement).data.modules[key] != false;
    }

    // Clinic profile doc: readable by members, never client-writable.
    match /clinics/{tid} {
      allow read: if isMember(tid);
      allow write: if false;
    }

    // All of a clinic's data. Isolated by membership + per-clinic module entitlement.
    // members/* and settings/entitlement are provisioned by LEADSERVE (not client-writable).
    match /clinics/{tid}/{col}/{docId} {
      allow read: if isMember(tid) && tenantModuleAllowed(tid, collectionModule(col));
      allow write: if isMember(tid)
        && tenantModuleAllowed(tid, collectionModule(col))
        && col != 'members'
        && !(col == 'settings' && docId == 'entitlement');
    }

    // Flat legacyRoot collections (the current demo). Excludes the 'clinics' root,
    // which is governed by the tenant rules above.
    match /{col}/{docId} {
      allow read: if signedIn() && notDeactivated()
        && col != 'clinics' && rootModuleAllowed(collectionModule(col));
      allow write: if signedIn() && notDeactivated()
        && col != 'clinics' && rootModuleAllowed(collectionModule(col))
        && !(col == 'settings' && docId == 'entitlement');
    }
  }
}
